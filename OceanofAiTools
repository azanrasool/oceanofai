    <script>
        // JavaScript for Search Functionality
        const searchInput = document.getElementById('searchInput');
        const toolList = document.getElementById('toolList');
        const toolItems = toolList.querySelectorAll('.tool-item'); // Get all list items

        // --- Debounce function (optional but good for performance) ---
        function debounce(func, delay) {
            let timeoutId;
            return function(...args) {
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => {
                    func.apply(this, args);
                }, delay);
            };
        }

        // --- Filter function ---
        function filterTools() {
            const searchTerm = searchInput.value.toLowerCase().trim(); // Get search term inside the function

            toolItems.forEach(item => {
                const toolDetails = item.querySelector('.tool-details');
                if (!toolDetails) return; // Skip malformed items

                const nameElement = toolDetails.querySelector('strong');
                const descriptionElement = toolDetails.querySelector('.tool-description');

                // Get text content, convert to lowercase, default to empty string if element not found
                const nameText = nameElement ? nameElement.textContent.toLowerCase() : '';
                const descriptionText = descriptionElement ? descriptionElement.textContent.toLowerCase() : '';

                // Check if search term is present in name OR description
                const isVisible = nameText.includes(searchTerm) || descriptionText.includes(searchTerm);

                // Add/Remove 'hidden' class for CSS transitions
                if (isVisible) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        }

        // --- Attach event listener with debounce ---
        // searchInput.addEventListener('input', debounce(filterTools, 250)); // Debounce with 250ms delay

        // --- Attach event listener without debounce (simpler) ---
         searchInput.addEventListener('input', filterTools);

        // --- Initial filter on page load (optional, if needed) ---
        // filterTools();

    </script>

